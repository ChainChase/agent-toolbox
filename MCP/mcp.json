{
  "mcpServers": {
    "Kaggle": {
      "command": "kaggle-mcp-server",
      "env": {
        "KAGGLE_KEY": "${KAGGLE_KEY}",
        "KAGGLE_USERNAME": "${KAGGLE_USERNAME}"
      }
    },
    "Atomgit": {
      "command": "npx",
      "args": [
        "-y",
        "@atomgit.com/atomgit-mcp-server"
      ],
      "env": {
        "ATOMGIT_ENABLE_DANGEROUS_TOOLS": "false",
        "ATOMGIT_TOKEN": "${ATOMGIT_TOKEN}"
      }
    },
    "Huawei Cloud": {
      "command": "node",
      "args": [
        "${HUAWEICLOUD_MCP_SERVER_PATH}"
      ],
      "env": {
        "HCLOUD_BIN": "${HCLOUD_BIN}"
      }
    },
    "Framelink MCP for Figma": {
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp",
        "--figma-api-key=${FIGMA_API_KEY}",
        "--stdio"
      ]
    },
    "ascend-doc": {
      "command": "npx",
      "args": [
        "-y",
        "ascend-doc-mcp@latest"
      ]
    }
  }
}